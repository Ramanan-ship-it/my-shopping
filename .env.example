# Backend Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=smart_dress_shop_jwt_secret_key_2026_production_grade_random

# Supabase / PostgreSQL Configuration (Optional for cloud production)
# When set, the system can connect to Supabase PostgreSQL.
# If not configured, the built-in SQLite engine runs seamlessly with 100% features locally.
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_ANON_KEY=example-anon-key-not-real
SUPABASE_SERVICE_ROLE_KEY=example-service-role-key-never-commit-real-secrets

# WhatsApp Business API (Optional)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# Client Configuration
VITE_API_URL=/api
